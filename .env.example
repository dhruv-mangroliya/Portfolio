# Copy to .env and adjust. Empty values fall back to the defaults shown.
# Do NOT set NODE_ENV here — npm scripts set it (it would break the Vite build).

# ----- Server -----
PORT=5050
# fatal | error | warn | info | debug | trace | silent  (default: info)
LOG_LEVEL=

# ----- Database (MongoDB) -----
# Local:  mongodb://127.0.0.1:27017/dhruv_site
# Atlas:  mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/dhruv_site
MONGODB_URI=mongodb://127.0.0.1:27017/dhruv_site
# Used by `npm test` (must be a separate database; it is wiped on every run)
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/dhruv_site_test

# ----- Auth -----
# Long random string, required in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=7
# true when served over HTTPS (default: true in production)
COOKIE_SECURE=

# ----- HTTP -----
# Set to 1 behind a reverse proxy / PaaS (Render, Railway, Nginx…)
TRUST_PROXY=0
# Only if the frontend is hosted on a different domain (comma separated)
CORS_ORIGINS=

# ----- SEO -----
# Public address of the site (enables canonical URL, og:url and the photo as link-preview image)
SITE_URL=
