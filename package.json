{
  "name": "dhruv-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dhruv Mangroliya — portfolio, admin dashboard and (soon) personal life trackers.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/src/server.js",
    "set-admin": "node --env-file-if-exists=.env scripts/set-admin.js",
    "test": "NODE_ENV=test node --env-file-if-exists=.env --test --test-concurrency=1 \"server/tests/**/*.test.js\"",
    "copy-to-atlas": "node --env-file-if-exists=.env scripts/copy-to-atlas.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "vite": "^5.4.21"
  }
}
